  interactions      LeadInteraction[]
  todos             Todo[]
  proposals         Proposal[]
  convertedToClient Client?             @relation("ConvertedLead", fields: [convertedToClientId], references: [id])
  timesheetEntries  TimesheetEntry[]    // New relation
  bills             Bill[]               // New relation
}

