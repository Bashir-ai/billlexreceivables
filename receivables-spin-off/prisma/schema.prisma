model Project {
  id          String        @id @default(cuid())
  proposalId  String?
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  currency    String        @default("EUR")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime? // Archive (different from delete - can be unarchived)
  
  // Billing configuration fields
  useBlendedRate       Boolean? // Whether to use blended rate for this project
  blendedRate          Float?   // Project-specific blended rate
  hourlyRateTableType String?   // "FIXED_RATE", "RATE_RANGE", "HOURLY_TABLE", or null
  hourlyRateTableRates Json?    // JSON object storing hourly table rates by profile
  hourlyRateRangeMin   Float?   // Minimum rate for rate range
  hourlyRateRangeMax   Float?   // Maximum rate for rate range

  @@index([clientId])
  @@index([proposalId])
  @@index([status])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([clientId, deletedAt, archivedAt])
  @@index([createdAt])

  // Relations
  proposal         Proposal?        @relation(fields: [proposalId], references: [id])
  client           Client           @relation(fields: [clientId], references: [id])
  bills            Bill[]
  timesheetEntries TimesheetEntry[]
  charges          ProjectCharge[]
  projectManagers  ProjectManager[]
  todos            Todo[]
  expenses         ProjectExpense[]
  compensationEligibility CompensationEligibility[] @relation("EligibilityProject")
  interactions     ProjectInteraction[]
  userRates        ProjectUserRate[]
  billAttributionSnapshots BillAttributionSnapshot[] @relation("BillAttributionSnapshotProject")
}

model PaymentTerm {
