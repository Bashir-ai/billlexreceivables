  clientId         String?
  leadId           String?
  assignedTo       String
  createdBy        String
  status           TodoStatus   @default(PENDING)
  priority         TodoPriority @default(MEDIUM)
  isPersonal       Boolean      @default(false)
  startDate        DateTime?
  estimatedEndDate DateTime?
  dueDate          DateTime?
  readAt           DateTime?
  completedAt      DateTime?
  completedBy      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([assignedTo])
  @@index([status])
  @@index([clientId])
  @@index([projectId])
  @@index([proposalId])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([assignedTo, status])
  @@index([createdBy])
  @@index([readAt])

  // Relations
