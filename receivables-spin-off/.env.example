# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/receivables_spin_off?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace_me"
# When tunneling, NEXTAUTH_URL MUST be the public https origin (no trailing slash).
# Quick: npm run tunnel:env -- --write-env-tunnel https://your-subdomain.ngrok-free.app && npm run dev:tunnel
# Or print vars: npm run tunnel:env -- https://your-subdomain.ngrok-free.app  — See docs/TUNNEL_DEV.md

# Email (Resend)
RESEND_API_KEY="replace_me"
FROM_EMAIL="noreply@example.com"

# Cron security
CRON_SECRET="replace_me"

# Optional base URL used in some email templates / redirects (match NEXTAUTH_URL when tunneling)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Avaza integration
# For most setups this can stay at the default; token is required.
AVAZA_API_BASE_URL="https://api.avaza.com"
AVAZA_API_TOKEN="replace_with_avaza_personal_access_token"
# Optional: attribute imported records to this user ID (defaults to earliest ADMIN user).
AVAZA_SYNC_CREATED_BY_USER_ID=""

NODE_ENV="development"

